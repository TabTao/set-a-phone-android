<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preview"
    android:keepScreenOn="true">
    <ImageView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/preview_surface"
        android:contentDescription="远程预览"
        android:scaleType="centerCrop" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="false" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/hostInput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/text_field"
                android:hint="PC IP"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />
            <Button
                android:id="@+id/connectButton"
                style="@style/CameraToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="连接" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxWidth="120dp"
                android:text="未连接"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/menuOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="142dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/camera_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">
        <Button
            android:id="@+id/multiplierButton"
            style="@style/CameraIconButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="倍率" />
        <Button
            android:id="@+id/calibrateButton"
            style="@style/CameraIconButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="归零" />
        <Button
            android:id="@+id/placeholderButton"
            style="@style/CameraIconButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="占位" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/adjustmentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="142dp"
        android:background="@drawable/camera_panel"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/scaleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="倍率 0.20x"
            android:textColor="@color/text"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/pitchScale"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:max="99"
            android:progress="19" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <Button
            android:id="@+id/shutterButton"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@drawable/shutter_button"
            android:contentDescription="拍照"
            android:text=""
            android:textColor="@android:color/transparent" />
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/camera_circle_button"
                android:contentDescription="打开菜单"
                android:src="@drawable/ic_menu_placeholder" />
            <Button
                android:id="@+id/previewModeButton"
                style="@style/CameraIconButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:contentDescription="切换相机或场景"
                android:text="场景" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
