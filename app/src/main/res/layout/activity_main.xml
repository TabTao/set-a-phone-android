<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:keepScreenOn="true">
    <ImageView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="142dp"
        android:background="@drawable/preview_surface"
        android:contentDescription="相机预览"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <EditText
            android:id="@+id/hostInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/text_field"
            android:hint="PC IP"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />
        <Button
            android:id="@+id/connectButton"
            style="@style/CameraToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="连接" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:text="未连接"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:id="@+id/leftButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button android:id="@+id/left1" style="@style/FunctionButton" android:text="1" />
            <Button android:id="@+id/left2" style="@style/FunctionButton" android:text="2" />
            <Button android:id="@+id/left3" style="@style/FunctionButton" android:text="3" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/shutterButton"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/shutter_button"
                android:contentDescription="拍照"
                android:text="4"
                android:textColor="@android:color/transparent" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <Button
                    android:id="@+id/calibrateButton"
                    style="@style/CameraToolbarButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="配对归零" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="倍率"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
                <SeekBar
                    android:id="@+id/pitchScale"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:max="99"
                    android:progress="19" />
                <TextView
                    android:id="@+id/scaleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="倍率 0.20x"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rightButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button android:id="@+id/right1" style="@style/FunctionButton" android:text="1" />
            <Button android:id="@+id/right2" style="@style/FunctionButton" android:text="2" />
            <Button android:id="@+id/right3" style="@style/FunctionButton" android:text="3" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
