<resources>
    <style name="FunctionButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/function_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CameraToolbarButton">
        <item name="android:background">@drawable/toolbar_button</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
